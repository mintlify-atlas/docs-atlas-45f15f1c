  "keyFeatures": [
    "Autonomous multi-task execution with fresh context per task",
    "Automated git branch-per-slice with squash merge strategy",
    "State machine driven by disk files for crash recovery",
    "Cost tracking and budget ceilings per model and phase",
    "Timeout supervision with soft/idle/hard timeouts",
    "Multi-provider LLM support with per-phase model selection",
    "Real-time dashboard overlay with progress tracking",
    "Built-in extensions for browser automation, web search, and more",
    "Migration tool from GSD v1 to v2 format"
  ],
  "publicApiSurface": [
    "/gsd - Step mode with contextual wizard",
    "/gsd auto - Autonomous mode execution",
    "/gsd next - Explicit step mode",
    "/gsd stop - Stop auto mode gracefully",
    "/gsd discuss - Architecture discussion mode",
    "/gsd status - Progress dashboard",
    "/gsd queue - Queue future milestones",
    "/gsd prefs - Model selection and preferences",
    "/gsd migrate - Migrate from v1 format",
    "/gsd doctor - Validate .gsd/ directory",
    "/worktree (/wt) - Git worktree management",
    "/voice - Toggle speech-to-text",
    "/exit - Graceful exit",
    "/clear - Start new session",
    "gsd config - Setup wizard",
    "gsd --continue (-c) - Resume session"
  ]
